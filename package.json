{
  "name": "yangshao-lab-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:admin": "pnpm --filter yangshao-admin dev",
    "dev:server": "pnpm --filter yangshao-server dev",
    "desktop:test": "pnpm --filter @yangshao/desktop test",
    "desktop:build": "pnpm --filter @yangshao/desktop build",
    "build": "vue-tsc --noEmit && vite build",
    "build:admin": "pnpm --filter yangshao-admin build",
    "build:server": "pnpm --filter yangshao-server build",
    "build:all": "pnpm build && pnpm build:admin && pnpm build:server",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:server": "pnpm --filter yangshao-server test",
    "test:all": "pnpm test && pnpm test:server",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.3",
    "markdown-it": "15.0.2",
    "pinia": "^2.3.1",
    "sass": "^1.83.4",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-element-plus-x": "2.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.7.0"
}
