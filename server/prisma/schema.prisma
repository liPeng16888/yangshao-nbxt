  id                String    @id @default(uuid())
  frontendUserId    String
  employeeId        String
  commissionTypeId  String
  date              String
  quantity          Decimal   @db.Decimal(12, 3)
  unitPriceSnapshot Decimal   @db.Decimal(12, 2)
  amount            Decimal   @db.Decimal(12, 2)
  remark            String?
  payrollLockedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  frontendUser   User                   @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee       Employee               @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  commissionType EmployeeCommissionType @relation(fields: [commissionTypeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
  @@index([frontendUserId, employeeId, date])
  @@index([commissionTypeId])
}

model EmployeeBonus {
  id              String    @id @default(uuid())
  frontendUserId  String
  employeeId      String
  date            String
  amount          Decimal   @db.Decimal(12, 2)
  reason          String
  payrollLockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
  @@index([frontendUserId, employeeId, date])
}

model EmployeePayrollRun {
  id             String                @id @default(uuid())
  frontendUserId String
  month          String
  status         EmployeePayrollStatus @default(DRAFT)
  confirmedById  String?
  confirmedAt    DateTime?
  reopenReason   String?
  reopenedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  frontendUser User                  @relation("FrontendEmployeePayrollRuns", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy  User?                 @relation("EmployeePayrollConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        EmployeePayrollItem[]

  @@unique([frontendUserId, month])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, status, month])
}

model EmployeePayrollItem {
  id                     String   @id @default(uuid())
  frontendUserId         String
  payrollRunId           String
  employeeId             String
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  baseSalary             Decimal  @db.Decimal(12, 2)
  attendanceBonus        Decimal  @db.Decimal(12, 2)
  scheduledWorkDays      Decimal  @db.Decimal(6, 2)
  restQuotaDays          Decimal  @db.Decimal(6, 2)
  countedLeaveDays       Decimal  @db.Decimal(6, 2)
  excessLeaveDays        Decimal  @db.Decimal(6, 2)
  absenceDays            Decimal  @db.Decimal(6, 2)
  dailyRate              Decimal  @db.Decimal(12, 2)
  leaveDeduction         Decimal  @db.Decimal(12, 2)
  absenceDeduction       Decimal  @db.Decimal(12, 2)
  overtimeMinutes        Int
  overtimeHourlyRate     Decimal  @db.Decimal(12, 2)
  overtimePay            Decimal  @db.Decimal(12, 2)
  commissionAmount       Decimal  @db.Decimal(12, 2)
  bonusAmount            Decimal  @db.Decimal(12, 2)
  adjustmentAmount       Decimal  @db.Decimal(12, 2)
  payableAmount          Decimal  @db.Decimal(12, 2)
  issues                 Json
  calculationSnapshot    Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  frontendUser User                        @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payrollRun   EmployeePayrollRun          @relation(fields: [payrollRunId, frontendUserId], references: [id, frontendUserId], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee                    @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  adjustments  EmployeePayrollAdjustment[]

  @@unique([payrollRunId, employeeId])
  @@unique([id, employeeId, frontendUserId])
  @@index([frontendUserId, employeeId])
}

model EmployeePayrollAdjustment {
  id             String   @id @default(uuid())
  frontendUserId String
  payrollItemId  String
  employeeId     String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payrollItem  EmployeePayrollItem @relation(fields: [payrollItemId, employeeId, frontendUserId], references: [id, employeeId, frontendUserId], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee            @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, payrollItemId])
  @@index([frontendUserId, employeeId])
}

model EmployeeAuditLog {
  id             String              @id @default(uuid())
  frontendUserId String
  actorUserId    String
  action         EmployeeAuditAction
  entityType     String
  entityId       String
  reason         String?
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime            @default(now())

  frontendUser User @relation("FrontendEmployeeAuditLogs", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser    User @relation("EmployeeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, createdAt])
  @@index([frontendUserId, entityType, entityId])
  @@index([actorUserId, createdAt])
}
