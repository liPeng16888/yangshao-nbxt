generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ROOT_ADMIN
  SUB_ADMIN
  FRONTEND_USER
  FRONTEND_SUB_USER
}

enum FrontendMenuPermission {
  DATA_MAIN
  DATA_STANDARD_SAMPLE
  DATA_COEFFICIENT
  LAB_REPORT_IMAGE_TEMPLATE
  LAB_REPORT_SMS_TEMPLATE
  ATTENDANCE_OVERVIEW
  ATTENDANCE_EMPLOYEES
  ATTENDANCE_SCHEDULES
  ATTENDANCE_RECORDS
  ATTENDANCE_LEAVE
  ATTENDANCE_COMPENSATION
  ATTENDANCE_PAYROLL
  FINANCE_EXPENSES
  FINANCE_INCOME
  FINANCE_UNSETTLED
  FINANCE_MONTHLY_SETTLEMENT
  PREPAID_RECHARGE
  PREPAID_CUSTOMERS
  PREPAID_CONSUMPTIONS
  PREPAID_SETTLEMENTS
  REPORTS
  MEDICINE_STOCK
  MEDICINE_INBOUND
  MEDICINE_OUTBOUND
  CUSTOMER_OVERVIEW
  BLACKLIST
}

enum PaymentMethod {
  cash
  online
}

enum SamplePaymentStatus {
  PAID
  UNPAID
  MONTHLY
  PREPAID
  UNSELECTED
}

enum MonthlySettlementStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ReminderType {
  UNSETTLED_PAYMENT
  MONTHLY_PAYMENT
  FINANCE_DELETE_APPROVED
  FINANCE_DELETE_REJECTED
}

enum FinanceDeletionRequestType {
  EXPENSE
  PREPAID_RECHARGE
}

enum FinanceDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MedicineUnit {
  BOTTLE
  LITER
  MILLILITER
  GRAM
}

enum MedicineMovementType {
  INBOUND
  OUTBOUND
  CORRECTION_IN
  CORRECTION_OUT
}

enum AccessGuardFeature {
  FINANCE
  REPORTS
  BLACKLIST
  HISTORICAL_DATES
  MEDICINE_INVENTORY
  CUSTOMER_OVERVIEW
  COMPLETED_SAMPLE_DATA
  EMPLOYEE_ATTENDANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeLeaveUnit {
  HOUR
  HALF_DAY
  FULL_DAY
}

enum EmployeeLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeePayrollStatus {
  DRAFT
  CONFIRMED
}

enum EmployeeAuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CONFIRM
  REOPEN
  REVEAL
}

enum SharedPrepaidLedgerKind {
  RECHARGE
  CONSUMPTION
  CONSUMPTION_REVERSAL
  RECHARGE_REVERSAL
}

enum SharedPrepaidConsumptionKind {
  CONSUMPTION
  REVERSAL
}

enum SharedPrepaidPayableStatus {
  PENDING
  HELD
  COMPLETED
  REVERSED
}

enum SharedPrepaidSettlementStatus {
  AWAITING_PAYMENT
  AWAITING_RECEIPT
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id                          String    @id @default(uuid())
  account                     String    @unique
  username                    String
  displayRemark               String?
  role                        UserRole
  parentFrontendUserId        String?
  permissionVersion           Int       @default(1)
  requiresAccessGuardPassword Boolean   @default(true)
  lastLoginAt                 DateTime?
  passwordHash                String
  passwordCipher              String?
  accessGuardEnabled          Boolean   @default(false)
  accessGuardPassword         String?
  accessGuardTtlMinutes       Int       @default(5)
  accessGuardRecoveryPrompt   String?
  accessGuardRecoveryAnswer   String?
  disabled                    Boolean   @default(false)
  disabledReason              String?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  frontendSheets                    LabSheet[]                     @relation("FrontendSheets")
  financeEntries                    FinanceEntry[]                 @relation("FrontendFinance")
  monthlyCustomerRemarks            MonthlyCustomerRemark[]        @relation("FrontendMonthlyCustomerRemarks")
  prepaidRecharges                  PrepaidRechargeRecord[]        @relation("FrontendPrepaidRecharges")
  prepaidCustomerRemarks            PrepaidCustomerRemark[]        @relation("FrontendPrepaidCustomerRemarks")
  prepaidUsageRemarks               PrepaidUsageRemark[]           @relation("FrontendPrepaidUsageRemarks")
  customers                         Customer[]                     @relation("FrontendCustomers")
  blacklistUploads                  BlacklistRecord[]              @relation("BlacklistUploader")
  reminders                         Reminder[]                     @relation("FrontendReminders")
  createdReminders                  Reminder[]                     @relation("ReminderCreator")
  financeDeletionRequests           FinanceDeletionRequest[]       @relation("FrontendFinanceDeletionRequests")
  reviewedFinanceDeletionRequests   FinanceDeletionRequest[]       @relation("ReviewedFinanceDeletionRequests")
  inviteCodes                       InviteCode[]                   @relation("InviteCreator")
  usedInviteCodes                   InviteCode[]                   @relation("InviteUser")
  createdSubPerms                   SubAdminFrontendPermission[]   @relation("PermissionCreator")
  subAdminPerms                     SubAdminFrontendPermission[]   @relation("SubAdminPermissions")
  frontendPerms                     SubAdminFrontendPermission[]   @relation("FrontendPermissions")
  medicineItems                     MedicineInventoryItem[]        @relation("FrontendMedicineItems")
  medicineMovements                 MedicineInventoryMovement[]    @relation("FrontendMedicineMovements")
  medicineCommonNames               MedicineCommonName[]           @relation("FrontendMedicineCommonNames")
  accessGuardGroups                 AccessGuardGroup[]             @relation("FrontendAccessGuardGroups")
  accessGuardGroupFeatures          AccessGuardGroupFeature[]      @relation("FrontendAccessGuardGroupFeatures")
  employees                         Employee[]
  employeeWeeklySchedules           EmployeeWeeklySchedule[]
  employeeDateOverrides             EmployeeDateOverride[]
  employeeMonthlySettings           EmployeeMonthlySetting[]
  employeeAttendanceRecords         EmployeeAttendanceRecord[]
  employeeLeaveTypes                EmployeeLeaveType[]
  employeeLeaveRequests             EmployeeLeaveRequest[]         @relation("FrontendEmployeeLeaveRequests")
  reviewedEmployeeLeaveRequests     EmployeeLeaveRequest[]         @relation("EmployeeLeaveReviewer")
  employeeCommissionTypes           EmployeeCommissionType[]
  employeeCommissionRecords         EmployeeCommissionRecord[]
  employeeBonuses                   EmployeeBonus[]
  employeePayrollRuns               EmployeePayrollRun[]           @relation("FrontendEmployeePayrollRuns")
  confirmedEmployeePayrollRuns      EmployeePayrollRun[]           @relation("EmployeePayrollConfirmer")
  employeePayrollItems              EmployeePayrollItem[]
  employeePayrollAdjustments        EmployeePayrollAdjustment[]
  employeeAuditLogs                 EmployeeAuditLog[]             @relation("FrontendEmployeeAuditLogs")
  performedEmployeeAuditLogs        EmployeeAuditLog[]             @relation("EmployeeAuditActor")
  createdSharedPrepaidMembers       SharedPrepaidMember[]          @relation("SharedPrepaidMemberCreator")
  ownedSharedPrepaidRecharges       SharedPrepaidRecharge[]        @relation("SharedPrepaidRechargeOwner")
  actedSharedPrepaidRecharges       SharedPrepaidRecharge[]        @relation("SharedPrepaidRechargeActor")
  ownedSharedPrepaidLedgerEntries   SharedPrepaidLedgerEntry[]     @relation("SharedPrepaidLedgerEntryOwner")
  actedSharedPrepaidLedgerEntries   SharedPrepaidLedgerEntry[]     @relation("SharedPrepaidLedgerEntryActor")
  sharedPrepaidConsumptions         SharedPrepaidConsumption[]     @relation("SharedPrepaidConsumptionOwner")
  actedSharedPrepaidConsumptions    SharedPrepaidConsumption[]     @relation("SharedPrepaidConsumptionActor")
  sharedPrepaidAllocationSources    SharedPrepaidAllocation[]      @relation("SharedPrepaidAllocationSourceOwner")
  sourceSharedPrepaidPayables       SharedPrepaidPayable[]         @relation("SharedPrepaidPayableSourceOwner")
  consumerSharedPrepaidPayables     SharedPrepaidPayable[]         @relation("SharedPrepaidPayableConsumerOwner")
  sharedPrepaidSettlementsAsA       SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementAccountA")
  sharedPrepaidSettlementsAsB       SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementAccountB")
  paidSharedPrepaidSettlements      SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementPayer")
  receivedSharedPrepaidSettlements  SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementReceiver")
  createdSharedPrepaidSettlements   SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementCreator")
  submittedSharedPrepaidPayments    SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementPaymentSubmitter")
  confirmedSharedPrepaidReceipts    SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementReceiptConfirmer")
  rejectedSharedPrepaidSettlements  SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementRejector")
  cancelledSharedPrepaidSettlements SharedPrepaidSettlement[]      @relation("SharedPrepaidSettlementCanceller")
  parentFrontendUser                User?                          @relation("FrontendSubAccounts", fields: [parentFrontendUserId], references: [id], onDelete: Restrict)
  frontendSubAccounts               User[]                         @relation("FrontendSubAccounts")
  frontendSubAccountPermissions     FrontendSubAccountPermission[]

  @@index([role])
  @@index([parentFrontendUserId])
  @@index([deletedAt])
}

model FrontendSubAccountPermission {
  id           String                 @id @default(uuid())
  subAccountId String
  permission   FrontendMenuPermission
  createdAt    DateTime               @default(now())

  subAccount User @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([subAccountId, permission])
  @@index([subAccountId])
}

model AccessGuardGroup {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  enabled        Boolean  @default(true)
  ttlMinutes     Int      @default(5)
  grantVersion   Int      @default(1)
  password       String
  recoveryPrompt String
  recoveryAnswer String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                      @relation("FrontendAccessGuardGroups", fields: [frontendUserId], references: [id], onDelete: Cascade)
  features     AccessGuardGroupFeature[]

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model AccessGuardGroupFeature {
  id             String             @id @default(uuid())
  groupId        String
  frontendUserId String
  feature        AccessGuardFeature
  createdAt      DateTime           @default(now())

  group        AccessGuardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  frontendUser User             @relation("FrontendAccessGuardGroupFeatures", fields: [frontendUserId], references: [id], onDelete: Cascade)

  @@unique([frontendUserId, feature])
  @@unique([groupId, feature])
  @@index([groupId])
}

model Customer {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  phone          String?
  wechat         String?
  wechatNickname String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendCustomers", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  note        String?
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  usedById    String?

  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id])
}

model SubAdminFrontendPermission {
  id             String   @id @default(uuid())
  subAdminId     String
  frontendUserId String
  createdById    String
  createdAt      DateTime @default(now())

  subAdmin     User @relation("SubAdminPermissions", fields: [subAdminId], references: [id])
  frontendUser User @relation("FrontendPermissions", fields: [frontendUserId], references: [id])
  createdBy    User @relation("PermissionCreator", fields: [createdById], references: [id])

  @@unique([subAdminId, frontendUserId])
  @@index([frontendUserId])
}

model LabSheet {
  id             String   @id @default(uuid())
  frontendUserId String
  date           String
  readonly       Boolean  @default(false)
  parameters     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser              User                       @relation("FrontendSheets", fields: [frontendUserId], references: [id])
  sampleBlocks              SampleBlock[]
  changeLogs                CellChangeLog[]
  abnormalRecords           AbnormalRecord[]
  sharedPrepaidConsumptions SharedPrepaidConsumption[] @relation("SharedPrepaidConsumptionSheet")

  @@unique([frontendUserId, date])
  @@index([date])
}

model SampleBlock {
  id                String   @id @default(uuid())
  sheetId           String
  index             Int
  readonly          Boolean  @default(false)
  inputs            Json
  results           Json
  parameterSnapshot Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sheet                     LabSheet                   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  changeLogs                CellChangeLog[]
  abnormalRecords           AbnormalRecord[]
  sharedPrepaidConsumptions SharedPrepaidConsumption[] @relation("SharedPrepaidConsumptionBlock")

  @@unique([sheetId, index])
  @@index([sheetId])
}

model CellChangeLog {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  field          String
  oldValue       Json?
  newValue       Json?
  changedById    String
  changedAt      DateTime @default(now())

  sheet LabSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block SampleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([frontendUserId, changedAt])
  @@index([blockId, field])
}

model AbnormalRecord {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  date           String
  field          String
  changeCount    Int
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sheet LabSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block SampleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, field])
  @@index([frontendUserId, date])
}

model FinanceEntry {
  id             String        @id @default(uuid())
  frontendUserId String
  paymentDate    String
  registeredAt   DateTime      @default(now())
  item           String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  screenshotUrl  String?
  remark         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  frontendUser User @relation("FrontendFinance", fields: [frontendUserId], references: [id])

  @@index([frontendUserId, paymentDate])
}

model MonthlySettlementRecord {
  id             String                  @id @default(uuid())
  month          String
  frontendUserId String
  customer       String
  status         MonthlySettlementStatus @default(UNPAID)
  paidAmount     Decimal?                @db.Decimal(12, 2)
  remark         String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([month, frontendUserId, customer])
  @@index([frontendUserId, month])
}

model MonthlyCustomerRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendMonthlyCustomerRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, customer])
  @@index([frontendUserId])
}

model PrepaidRechargeRecord {
  id             String   @id @default(uuid())
  frontendUserId String
  rechargeDate   String
  customer       String
  amount         Decimal  @db.Decimal(12, 2)
  usableTimes    Int
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidRecharges", fields: [frontendUserId], references: [id])

  @@index([frontendUserId, rechargeDate])
  @@index([frontendUserId, customer])
}

model PrepaidCustomerRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidCustomerRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, customer])
  @@index([frontendUserId])
}

model PrepaidUsageRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  usageDate      String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidUsageRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, usageDate, customer])
  @@index([frontendUserId, usageDate])
}

model SharedPrepaidMember {
  id            String   @id @default(uuid())
  phone         String   @unique
  cachedBalance Decimal  @default(0) @db.Decimal(14, 2)
  version       Int      @default(1)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User                       @relation("SharedPrepaidMemberCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recharges     SharedPrepaidRecharge[]    @relation("SharedPrepaidRechargeMember")
  ledgerEntries SharedPrepaidLedgerEntry[] @relation("SharedPrepaidLedgerEntryMember")
  consumptions  SharedPrepaidConsumption[] @relation("SharedPrepaidConsumptionMember")
}

model SharedPrepaidRecharge {
  id                  String    @id @default(uuid())
  memberId            String
  ownerFrontendUserId String
  actorUserId         String
  rechargeDate        String
  paidAmount          Decimal   @db.Decimal(14, 2)
  giftAmount          Decimal   @db.Decimal(14, 2)
  totalAmount         Decimal   @db.Decimal(14, 2)
  remainingAmount     Decimal   @db.Decimal(14, 2)
  isOpeningBalance    Boolean   @default(false)
  remark              String?
  idempotencyKey      String    @unique
  reversedAt          DateTime?
  reversedByLedgerId  String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  member            SharedPrepaidMember       @relation("SharedPrepaidRechargeMember", fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerFrontendUser User                      @relation("SharedPrepaidRechargeOwner", fields: [ownerFrontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser         User                      @relation("SharedPrepaidRechargeActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedByLedger  SharedPrepaidLedgerEntry? @relation("SharedPrepaidRechargeReversalLedger", fields: [reversedByLedgerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocations       SharedPrepaidAllocation[] @relation("SharedPrepaidAllocationRecharge")

  @@index([memberId, ownerFrontendUserId, rechargeDate, createdAt, id])
}

model SharedPrepaidLedgerEntry {
  id                  String                  @id @default(uuid())
  memberId            String
  kind                SharedPrepaidLedgerKind
  balanceDelta        Decimal                 @db.Decimal(14, 2)
  ownerFrontendUserId String
  actorUserId         String
  referenceType       String
  referenceId         String
  idempotencyKey      String                  @unique
  createdAt           DateTime                @default(now())

  member            SharedPrepaidMember    @relation("SharedPrepaidLedgerEntryMember", fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerFrontendUser User                   @relation("SharedPrepaidLedgerEntryOwner", fields: [ownerFrontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser         User                   @relation("SharedPrepaidLedgerEntryActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedRecharge  SharedPrepaidRecharge? @relation("SharedPrepaidRechargeReversalLedger")

  @@index([memberId, createdAt])
  @@index([referenceType, referenceId])
}

model SharedPrepaidConsumption {
  id                      String                       @id @default(uuid())
  memberId                String
  consumingFrontendUserId String
  actorUserId             String
  kind                    SharedPrepaidConsumptionKind
  amount                  Decimal                      @db.Decimal(14, 2)
  sheetId                 String
  sampleBlockId           String
  sampleIndex             Int
  sampleNumberSnapshot    String?
  sampleCountSnapshot     Int                          @default(1)
  elementsSnapshot        Json
  phoneSnapshot           String
  sheetDate               String
  active                  Boolean                      @default(true)
  reversalOfId            String?                      @unique
  idempotencyKey          String                       @unique
  createdAt               DateTime                     @default(now())

  member                SharedPrepaidMember       @relation("SharedPrepaidConsumptionMember", fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumingFrontendUser User                      @relation("SharedPrepaidConsumptionOwner", fields: [consumingFrontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser             User                      @relation("SharedPrepaidConsumptionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sheet                 LabSheet                  @relation("SharedPrepaidConsumptionSheet", fields: [sheetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sampleBlock           SampleBlock               @relation("SharedPrepaidConsumptionBlock", fields: [sampleBlockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversalOf            SharedPrepaidConsumption? @relation("SharedPrepaidConsumptionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal              SharedPrepaidConsumption? @relation("SharedPrepaidConsumptionReversal")
  allocations           SharedPrepaidAllocation[] @relation("SharedPrepaidAllocationConsumption")
  payables              SharedPrepaidPayable[]    @relation("SharedPrepaidPayableConsumption")

  @@index([memberId, createdAt])
  @@index([consumingFrontendUserId, createdAt])
  @@index([sampleBlockId, active])
}

model SharedPrepaidAllocation {
  id                  String   @id @default(uuid())
  consumptionId       String
  rechargeId          String
  sourceOwnerId       String
  allocatedAmount     Decimal  @db.Decimal(14, 2)
  paidRatio           Decimal  @db.Decimal(20, 10)
  exactTransferAmount Decimal  @db.Decimal(20, 8)
  createdAt           DateTime @default(now())

  consumption SharedPrepaidConsumption @relation("SharedPrepaidAllocationConsumption", fields: [consumptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recharge    SharedPrepaidRecharge    @relation("SharedPrepaidAllocationRecharge", fields: [rechargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceOwner User                     @relation("SharedPrepaidAllocationSourceOwner", fields: [sourceOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([consumptionId, rechargeId])
  @@index([rechargeId])
}

model SharedPrepaidPayable {
  id              String                     @id @default(uuid())
  consumptionId   String
  sourceOwnerId   String
  consumerOwnerId String
  exactAmount     Decimal                    @db.Decimal(20, 8)
  amount          Decimal                    @db.Decimal(14, 1)
  status          SharedPrepaidPayableStatus @default(PENDING)
  reversalOfId    String?                    @unique
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  consumption     SharedPrepaidConsumption      @relation("SharedPrepaidPayableConsumption", fields: [consumptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceOwner     User                          @relation("SharedPrepaidPayableSourceOwner", fields: [sourceOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumerOwner   User                          @relation("SharedPrepaidPayableConsumerOwner", fields: [consumerOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversalOf      SharedPrepaidPayable?         @relation("SharedPrepaidPayableReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal        SharedPrepaidPayable?         @relation("SharedPrepaidPayableReversal")
  settlementLines SharedPrepaidSettlementLine[] @relation("SharedPrepaidSettlementLinePayable")

  @@unique([consumptionId, sourceOwnerId, consumerOwnerId])
  @@index([sourceOwnerId, consumerOwnerId, status, createdAt])
}

model SharedPrepaidSettlement {
  id                     String                        @id @default(uuid())
  accountAId             String
  accountBId             String
  aToBAmount             Decimal                       @db.Decimal(14, 1)
  bToAAmount             Decimal                       @db.Decimal(14, 1)
  netAmount              Decimal                       @db.Decimal(14, 1)
  payerFrontendUserId    String?
  receiverFrontendUserId String?
  status                 SharedPrepaidSettlementStatus
  actualTransferredAt    DateTime?
  proofUrls              Json
  remark                 String?
  createdById            String
  paymentSubmittedById   String?
  paymentSubmittedAt     DateTime?
  receiptConfirmedById   String?
  receiptConfirmedAt     DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  cancelledById          String?
  cancelledAt            DateTime?
  version                Int                           @default(1)
  idempotencyKey         String                        @unique
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  accountA             User                          @relation("SharedPrepaidSettlementAccountA", fields: [accountAId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountB             User                          @relation("SharedPrepaidSettlementAccountB", fields: [accountBId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payerFrontendUser    User?                         @relation("SharedPrepaidSettlementPayer", fields: [payerFrontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiverFrontendUser User?                         @relation("SharedPrepaidSettlementReceiver", fields: [receiverFrontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User                          @relation("SharedPrepaidSettlementCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentSubmittedBy   User?                         @relation("SharedPrepaidSettlementPaymentSubmitter", fields: [paymentSubmittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiptConfirmedBy   User?                         @relation("SharedPrepaidSettlementReceiptConfirmer", fields: [receiptConfirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rejectedBy           User?                         @relation("SharedPrepaidSettlementRejector", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy          User?                         @relation("SharedPrepaidSettlementCanceller", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                SharedPrepaidSettlementLine[] @relation("SharedPrepaidSettlementLineSettlement")

  @@index([accountAId, accountBId, status, createdAt])
}

model SharedPrepaidSettlementLine {
