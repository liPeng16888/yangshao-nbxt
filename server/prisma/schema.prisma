generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ROOT_ADMIN
  SUB_ADMIN
  FRONTEND_USER
}

enum PaymentMethod {
  cash
  online
}

enum SamplePaymentStatus {
  PAID
  UNPAID
  MONTHLY
  PREPAID
  UNSELECTED
}

enum MonthlySettlementStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ReminderType {
  UNSETTLED_PAYMENT
  MONTHLY_PAYMENT
  FINANCE_DELETE_APPROVED
  FINANCE_DELETE_REJECTED
}

enum FinanceDeletionRequestType {
  EXPENSE
  PREPAID_RECHARGE
}

enum FinanceDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MedicineUnit {
  BOTTLE
  LITER
  MILLILITER
  GRAM
}

enum MedicineMovementType {
  INBOUND
  OUTBOUND
  CORRECTION_IN
  CORRECTION_OUT
}

enum AccessGuardFeature {
  FINANCE
  REPORTS
  BLACKLIST
  HISTORICAL_DATES
  MEDICINE_INVENTORY
  CUSTOMER_OVERVIEW
  COMPLETED_SAMPLE_DATA
  EMPLOYEE_ATTENDANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeLeaveUnit {
  HOUR
  HALF_DAY
  FULL_DAY
}

enum EmployeeLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeePayrollStatus {
  DRAFT
  CONFIRMED
}

enum EmployeeAuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CONFIRM
  REOPEN
  REVEAL
}

model User {
  id                        String    @id @default(uuid())
  account                   String    @unique
  username                  String
  displayRemark             String?
  role                      UserRole
  passwordHash              String
  passwordCipher            String?
  accessGuardEnabled        Boolean   @default(false)
  accessGuardPassword       String?
  accessGuardTtlMinutes     Int       @default(5)
  accessGuardRecoveryPrompt String?
  accessGuardRecoveryAnswer String?
  disabled                  Boolean   @default(false)
  disabledReason            String?
  deletedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  frontendSheets                  LabSheet[]                   @relation("FrontendSheets")
  financeEntries                  FinanceEntry[]               @relation("FrontendFinance")
  monthlyCustomerRemarks          MonthlyCustomerRemark[]      @relation("FrontendMonthlyCustomerRemarks")
  prepaidRecharges                PrepaidRechargeRecord[]      @relation("FrontendPrepaidRecharges")
  prepaidCustomerRemarks          PrepaidCustomerRemark[]      @relation("FrontendPrepaidCustomerRemarks")
  prepaidUsageRemarks             PrepaidUsageRemark[]         @relation("FrontendPrepaidUsageRemarks")
  customers                       Customer[]                   @relation("FrontendCustomers")
  blacklistUploads                BlacklistRecord[]            @relation("BlacklistUploader")
  reminders                       Reminder[]                   @relation("FrontendReminders")
  createdReminders                Reminder[]                   @relation("ReminderCreator")
  financeDeletionRequests         FinanceDeletionRequest[]     @relation("FrontendFinanceDeletionRequests")
  reviewedFinanceDeletionRequests FinanceDeletionRequest[]     @relation("ReviewedFinanceDeletionRequests")
  inviteCodes                     InviteCode[]                 @relation("InviteCreator")
  usedInviteCodes                 InviteCode[]                 @relation("InviteUser")
  createdSubPerms                 SubAdminFrontendPermission[] @relation("PermissionCreator")
  subAdminPerms                   SubAdminFrontendPermission[] @relation("SubAdminPermissions")
  frontendPerms                   SubAdminFrontendPermission[] @relation("FrontendPermissions")
  medicineItems                   MedicineInventoryItem[]      @relation("FrontendMedicineItems")
  medicineMovements               MedicineInventoryMovement[]  @relation("FrontendMedicineMovements")
  medicineCommonNames             MedicineCommonName[]         @relation("FrontendMedicineCommonNames")
  accessGuardGroups               AccessGuardGroup[]           @relation("FrontendAccessGuardGroups")
  accessGuardGroupFeatures        AccessGuardGroupFeature[]    @relation("FrontendAccessGuardGroupFeatures")
  employees                       Employee[]
  employeeWeeklySchedules         EmployeeWeeklySchedule[]
  employeeDateOverrides           EmployeeDateOverride[]
  employeeMonthlySettings         EmployeeMonthlySetting[]
  employeeAttendanceRecords       EmployeeAttendanceRecord[]
  employeeLeaveTypes              EmployeeLeaveType[]
  employeeLeaveRequests           EmployeeLeaveRequest[]       @relation("FrontendEmployeeLeaveRequests")
  reviewedEmployeeLeaveRequests   EmployeeLeaveRequest[]       @relation("EmployeeLeaveReviewer")
  employeeCommissionTypes         EmployeeCommissionType[]
  employeeCommissionRecords       EmployeeCommissionRecord[]
  employeeBonuses                 EmployeeBonus[]
  employeePayrollRuns             EmployeePayrollRun[]         @relation("FrontendEmployeePayrollRuns")
  confirmedEmployeePayrollRuns    EmployeePayrollRun[]         @relation("EmployeePayrollConfirmer")
  employeePayrollItems            EmployeePayrollItem[]
  employeePayrollAdjustments      EmployeePayrollAdjustment[]
  employeeAuditLogs               EmployeeAuditLog[]           @relation("FrontendEmployeeAuditLogs")
  performedEmployeeAuditLogs      EmployeeAuditLog[]           @relation("EmployeeAuditActor")

  @@index([role])
  @@index([deletedAt])
}

model AccessGuardGroup {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  enabled        Boolean  @default(true)
  ttlMinutes     Int      @default(5)
  grantVersion   Int      @default(1)
  password       String
  recoveryPrompt String
  recoveryAnswer String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                      @relation("FrontendAccessGuardGroups", fields: [frontendUserId], references: [id], onDelete: Cascade)
  features     AccessGuardGroupFeature[]

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model AccessGuardGroupFeature {
  id             String             @id @default(uuid())
  groupId        String
  frontendUserId String
  feature        AccessGuardFeature
  createdAt      DateTime           @default(now())

  group        AccessGuardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  frontendUser User             @relation("FrontendAccessGuardGroupFeatures", fields: [frontendUserId], references: [id], onDelete: Cascade)

  @@unique([frontendUserId, feature])
  @@unique([groupId, feature])
  @@index([groupId])
}

model Customer {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  phone          String?
  wechat         String?
  wechatNickname String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendCustomers", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  note        String?
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  usedById    String?

  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id])
}

model SubAdminFrontendPermission {
  id             String   @id @default(uuid())
  subAdminId     String
  frontendUserId String
  createdById    String
  createdAt      DateTime @default(now())

  subAdmin     User @relation("SubAdminPermissions", fields: [subAdminId], references: [id])
  frontendUser User @relation("FrontendPermissions", fields: [frontendUserId], references: [id])
  createdBy    User @relation("PermissionCreator", fields: [createdById], references: [id])

  @@unique([subAdminId, frontendUserId])
  @@index([frontendUserId])
}

model LabSheet {
  id             String   @id @default(uuid())
  frontendUserId String
  date           String
  readonly       Boolean  @default(false)
  parameters     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser    User             @relation("FrontendSheets", fields: [frontendUserId], references: [id])
  sampleBlocks    SampleBlock[]
  changeLogs      CellChangeLog[]
  abnormalRecords AbnormalRecord[]

  @@unique([frontendUserId, date])
  @@index([date])
}

model SampleBlock {
  id                String   @id @default(uuid())
  sheetId           String
  index             Int
  readonly          Boolean  @default(false)
  inputs            Json
  results           Json
  parameterSnapshot Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sheet           LabSheet         @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  changeLogs      CellChangeLog[]
  abnormalRecords AbnormalRecord[]

  @@unique([sheetId, index])
  @@index([sheetId])
}

model CellChangeLog {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  field          String
  oldValue       Json?
  newValue       Json?
  changedById    String
  changedAt      DateTime @default(now())

  sheet LabSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block SampleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([frontendUserId, changedAt])
  @@index([blockId, field])
}

model AbnormalRecord {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  date           String
  field          String
  changeCount    Int
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sheet LabSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block SampleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, field])
  @@index([frontendUserId, date])
}

model FinanceEntry {
  id             String        @id @default(uuid())
  frontendUserId String
  paymentDate    String
  registeredAt   DateTime      @default(now())
  item           String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  screenshotUrl  String?
  remark         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  frontendUser User @relation("FrontendFinance", fields: [frontendUserId], references: [id])

  @@index([frontendUserId, paymentDate])
}

model MonthlySettlementRecord {
  id             String                  @id @default(uuid())
  month          String
  frontendUserId String
  customer       String
  status         MonthlySettlementStatus @default(UNPAID)
  paidAmount     Decimal?                @db.Decimal(12, 2)
  remark         String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([month, frontendUserId, customer])
  @@index([frontendUserId, month])
}

model MonthlyCustomerRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendMonthlyCustomerRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, customer])
  @@index([frontendUserId])
}

model PrepaidRechargeRecord {
  id             String   @id @default(uuid())
  frontendUserId String
  rechargeDate   String
  customer       String
  amount         Decimal  @db.Decimal(12, 2)
  usableTimes    Int
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidRecharges", fields: [frontendUserId], references: [id])

  @@index([frontendUserId, rechargeDate])
  @@index([frontendUserId, customer])
}

model PrepaidCustomerRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidCustomerRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, customer])
  @@index([frontendUserId])
}

model PrepaidUsageRemark {
  id             String   @id @default(uuid())
  frontendUserId String
  usageDate      String
  customer       String
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendPrepaidUsageRemarks", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, usageDate, customer])
  @@index([frontendUserId, usageDate])
}

model BlacklistRecord {
  id             String   @id @default(uuid())
  uploadedAt     DateTime @default(now())
  uploadedById   String
  phone          String?
  wechat         String?
  wechatNickname String?
  amount         Decimal? @db.Decimal(12, 2)
  images         Json
  other          String?
  note           String?

  uploadedBy User @relation("BlacklistUploader", fields: [uploadedById], references: [id])
}

model UploadedFile {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  createdAt    DateTime @default(now())
}

model Reminder {
  id             String       @id @default(uuid())
  frontendUserId String
  createdById    String?
  type           ReminderType
  title          String
  content        String
  sourceType     String?
  sourceId       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  frontendUser User  @relation("FrontendReminders", fields: [frontendUserId], references: [id])
  createdBy    User? @relation("ReminderCreator", fields: [createdById], references: [id])

  @@index([frontendUserId, readAt])
}

model FinanceDeletionRequest {
  id             String                       @id @default(uuid())
  frontendUserId String
  sourceType     FinanceDeletionRequestType
  sourceId       String
  reason         String
  sourceSnapshot Json
  status         FinanceDeletionRequestStatus @default(PENDING)
  reviewRemark   String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  frontendUser User  @relation("FrontendFinanceDeletionRequests", fields: [frontendUserId], references: [id])
  reviewedBy   User? @relation("ReviewedFinanceDeletionRequests", fields: [reviewedById], references: [id])

  @@index([frontendUserId, status])
  @@index([sourceType, sourceId])
  @@index([status, createdAt])
}

model MedicineInventoryItem {
  id              String                      @id @default(uuid())
  frontendUserId  String
  name            String
  unit            MedicineUnit
  currentQuantity Decimal                     @default(0) @db.Decimal(14, 3)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  frontendUser    User                        @relation("FrontendMedicineItems", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements       MedicineInventoryMovement[]

  @@unique([frontendUserId, name, unit])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, name])
}

model MedicineInventoryMovement {
  id                 String                     @id @default(uuid())
  frontendUserId     String
  medicineItemId     String
  type               MedicineMovementType
  occurredOn         String
  quantity           Decimal                    @db.Decimal(14, 3)
  nameSnapshot       String
  unitSnapshot       MedicineUnit
  remark             String?
  correctionOfId     String?
  createdAt          DateTime                   @default(now())
  frontendUser       User                       @relation("FrontendMedicineMovements", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  medicineItem       MedicineInventoryItem      @relation(fields: [medicineItemId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  originalMovement   MedicineInventoryMovement? @relation("MedicineMovementCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctionMovement MedicineInventoryMovement? @relation("MedicineMovementCorrection")

  @@unique([correctionOfId])
  @@index([frontendUserId, occurredOn])
  @@index([medicineItemId, occurredOn])
}

model MedicineCommonName {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendMedicineCommonNames", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([frontendUserId, name])
  @@index([frontendUserId, name])
}

model Employee {
  id                     String         @id @default(uuid())
  frontendUserId         String
  employeeNumber         String
  name                   String
  status                 EmployeeStatus @default(ACTIVE)
  phone                  String?
  idCardCipher           String?
  bankCardCipher         String?
  addressCipher          String?
  emergencyContactCipher String?
  photoPath              String?
  hireDate               String
  terminationDate        String?
  baseSalary             Decimal        @default(0) @db.Decimal(12, 2)
  attendanceBonus        Decimal        @default(0) @db.Decimal(12, 2)
  overtimeHourlyRate     Decimal        @default(0) @db.Decimal(12, 2)
  restQuotaDays          Decimal        @default(0) @db.Decimal(6, 2)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  frontendUser       User                        @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  weeklySchedules    EmployeeWeeklySchedule[]
  dateOverrides      EmployeeDateOverride[]
  monthlySettings    EmployeeMonthlySetting[]
  attendanceRecords  EmployeeAttendanceRecord[]
  leaveRequests      EmployeeLeaveRequest[]
  commissionRecords  EmployeeCommissionRecord[]
  bonuses            EmployeeBonus[]
  payrollItems       EmployeePayrollItem[]
  payrollAdjustments EmployeePayrollAdjustment[]

  @@unique([frontendUserId, employeeNumber])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, status])
  @@index([frontendUserId, name])
}

model EmployeeWeeklySchedule {
  id               String   @id @default(uuid())
  frontendUserId   String
  employeeId       String
  weekday          Int
  isWorkday        Boolean  @default(true)
  plannedStartTime String?
  plannedEndTime   String?
  scheduledMinutes Int      @default(480)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, weekday])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, employeeId])
}

model EmployeeDateOverride {
  id               String   @id @default(uuid())
  frontendUserId   String
  employeeId       String
  date             String
  isWorkday        Boolean
  plannedStartTime String?
  plannedEndTime   String?
  scheduledMinutes Int      @default(480)
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, date])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
}

model EmployeeMonthlySetting {
  id                String   @id @default(uuid())
  frontendUserId    String
  employeeId        String
  month             String
  scheduledWorkDays Decimal  @db.Decimal(6, 2)
  restQuotaDays     Decimal  @default(0) @db.Decimal(6, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, month])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, month])
}

model EmployeeAttendanceRecord {
  id                 String    @id @default(uuid())
  frontendUserId     String
  employeeId         String
  date               String
  isScheduledWorkday Boolean
  scheduledMinutes   Int       @default(0)
  checkInAt          DateTime?
  checkOutAt         DateTime?
  workedMinutes      Int       @default(0)
  lateMinutes        Int       @default(0)
  earlyLeaveMinutes  Int       @default(0)
  absenceMinutes     Int       @default(0)
  overtimeMinutes    Int       @default(0)
  manuallyEdited     Boolean   @default(false)
  remark             String?
  payrollLockedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, date])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
  @@index([frontendUserId, employeeId, date])
}

model EmployeeLeaveType {
  id                    String   @id @default(uuid())
  frontendUserId        String
  name                  String
  active                Boolean  @default(true)
  countsTowardRestQuota Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  frontendUser  User                   @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leaveRequests EmployeeLeaveRequest[]

  @@unique([frontendUserId, name])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, active])
}

model EmployeeLeaveRequest {
  id              String              @id @default(uuid())
  frontendUserId  String
  employeeId      String
  leaveTypeId     String
  startDate       String
  endDate         String
  unit            EmployeeLeaveUnit
  hours           Decimal?            @db.Decimal(6, 2)
  countedDays     Decimal             @db.Decimal(6, 2)
  reason          String
  status          EmployeeLeaveStatus @default(PENDING)
  reviewRemark    String?
  reviewedById    String?
  reviewedAt      DateTime?
  payrollLockedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  frontendUser User              @relation("FrontendEmployeeLeaveRequests", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee          @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  leaveType    EmployeeLeaveType @relation(fields: [leaveTypeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy   User?             @relation("EmployeeLeaveReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, status, startDate])
  @@index([frontendUserId, employeeId, startDate, endDate])
  @@index([leaveTypeId])
}

model EmployeeCommissionType {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  unitName       String
  unitPrice      Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                       @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  records      EmployeeCommissionRecord[]

  @@unique([frontendUserId, name])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, active])
}

model EmployeeCommissionRecord {
  id                String    @id @default(uuid())
  frontendUserId    String
  employeeId        String
  commissionTypeId  String
  date              String
  quantity          Decimal   @db.Decimal(12, 3)
  unitPriceSnapshot Decimal   @db.Decimal(12, 2)
  amount            Decimal   @db.Decimal(12, 2)
  remark            String?
  payrollLockedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  frontendUser   User                   @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee       Employee               @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  commissionType EmployeeCommissionType @relation(fields: [commissionTypeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
  @@index([frontendUserId, employeeId, date])
  @@index([commissionTypeId])
}

model EmployeeBonus {
  id              String    @id @default(uuid())
  frontendUserId  String
  employeeId      String
  date            String
  amount          Decimal   @db.Decimal(12, 2)
  reason          String
  payrollLockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  frontendUser User     @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee     Employee @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, date])
  @@index([frontendUserId, employeeId, date])
}

model EmployeePayrollRun {
  id             String                @id @default(uuid())
  frontendUserId String
  month          String
  status         EmployeePayrollStatus @default(DRAFT)
  confirmedById  String?
  confirmedAt    DateTime?
  reopenReason   String?
  reopenedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  frontendUser User                  @relation("FrontendEmployeePayrollRuns", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy  User?                 @relation("EmployeePayrollConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        EmployeePayrollItem[]

  @@unique([frontendUserId, month])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, status, month])
}

model EmployeePayrollItem {
  id                     String   @id @default(uuid())
  frontendUserId         String
  payrollRunId           String
  employeeId             String
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  baseSalary             Decimal  @db.Decimal(12, 2)
  attendanceBonus        Decimal  @db.Decimal(12, 2)
  scheduledWorkDays      Decimal  @db.Decimal(6, 2)
  restQuotaDays          Decimal  @db.Decimal(6, 2)
  countedLeaveDays       Decimal  @db.Decimal(6, 2)
  excessLeaveDays        Decimal  @db.Decimal(6, 2)
  absenceDays            Decimal  @db.Decimal(6, 2)
  dailyRate              Decimal  @db.Decimal(12, 2)
  leaveDeduction         Decimal  @db.Decimal(12, 2)
  absenceDeduction       Decimal  @db.Decimal(12, 2)
  overtimeMinutes        Int
  overtimeHourlyRate     Decimal  @db.Decimal(12, 2)
  overtimePay            Decimal  @db.Decimal(12, 2)
  commissionAmount       Decimal  @db.Decimal(12, 2)
  bonusAmount            Decimal  @db.Decimal(12, 2)
  adjustmentAmount       Decimal  @db.Decimal(12, 2)
  payableAmount          Decimal  @db.Decimal(12, 2)
  issues                 Json
  calculationSnapshot    Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  frontendUser User                        @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payrollRun   EmployeePayrollRun          @relation(fields: [payrollRunId, frontendUserId], references: [id, frontendUserId], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee                    @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)
  adjustments  EmployeePayrollAdjustment[]

  @@unique([payrollRunId, employeeId])
  @@unique([id, employeeId, frontendUserId])
  @@index([frontendUserId, employeeId])
}

model EmployeePayrollAdjustment {
  id             String   @id @default(uuid())
  frontendUserId String
  payrollItemId  String
  employeeId     String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payrollItem  EmployeePayrollItem @relation(fields: [payrollItemId, employeeId, frontendUserId], references: [id, employeeId, frontendUserId], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee            @relation(fields: [employeeId, frontendUserId], references: [id, frontendUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, payrollItemId])
  @@index([frontendUserId, employeeId])
}

model EmployeeAuditLog {
  id             String              @id @default(uuid())
  frontendUserId String
  actorUserId    String
  action         EmployeeAuditAction
  entityType     String
  entityId       String
  reason         String?
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime            @default(now())

  frontendUser User @relation("FrontendEmployeeAuditLogs", fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser    User @relation("EmployeeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, frontendUserId])
  @@index([frontendUserId, createdAt])
  @@index([frontendUserId, entityType, entityId])
  @@index([actorUserId, createdAt])
}
