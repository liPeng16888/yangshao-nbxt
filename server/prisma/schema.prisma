generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AI has no database credentials of its own. Business access is enforced by AiService.
model AiFeishuConfig {
  id              String   @id
  appId           String   @default("")
  appSecretCipher String   @default("")
  publicSiteUrl   String   @default("")
  enabled         Boolean  @default(false)
  revision        Int      @default(1)
  workerId        String?
  workerUntil     DateTime?
  updatedAt       DateTime @updatedAt
  bindings        AiFeishuBinding[]
  invitations     AiFeishuInvitation[]
  sessions        AiFeishuSession[]
  events          AiFeishuEvent[]
  @@index([appId])
}

model AiFeishuBinding {
  id             String   @id @default(uuid())
  configId       String   @default("frontend")
  config         AiFeishuConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  userId         String   @unique
  appId          String
  tenantKey      String
  openId         String
  chatId         String
  defaultModelId String
  roleSnapshot   String
  ownerSnapshot  String
  enabled        Boolean  @default(true)
  revokedAt      DateTime?
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([appId, tenantKey, openId])
  @@index([configId])
}

model AiFeishuInvitation {
  id             String   @id @default(uuid())
  configId       String   @default("frontend")
  config         AiFeishuConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  userId         String
  defaultModelId String
  appId          String
  codeHash       String   @unique
  proofHash      String?  @unique
  tenantKey      String?
  openId         String?
  chatId         String?
  expiresAt      DateTime
  claimedAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([userId, expiresAt])
  @@index([configId])
}

model AiFeishuSession {
  id                  String   @id @default(uuid())
  configId            String   @default("frontend")
  config              AiFeishuConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  appId               String
  tenantKey           String
  openId              String
  chatId              String
  bindingId           String?
  ownerId             String?
  conversationId      String?
  revision            Int      @default(1)
  authorityHash       String?
  grantsCipher        String?
  accessProofHash     String?  @unique
  accessProofExpiresAt DateTime?
  updatedAt           DateTime @updatedAt
  @@unique([configId, appId, tenantKey, openId, chatId])
}

model AiFeishuAction {
  id              String   @id @default(uuid())
  tokenHash       String   @unique
  sessionId       String
  sessionRevision Int
  bindingId       String?
  bindingRevision Int?
  configRevision  Int
  kind            String
  targetId        String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  @@index([sessionId, expiresAt])
}

// Both inbound and outbound bodies are encrypted; retries only resend saved results.
model AiFeishuEvent {
  sequence       Int      @unique @default(autoincrement())
  id             String   @id @default(uuid())
  configId       String   @default("frontend")
  config         AiFeishuConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  appId          String
  configRevision Int
  eventKey       String
  chatId         String
  tenantKey      String
  openId         String
  inputCipher    String
  outputCipher   String?
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  startedAt      DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([appId, eventKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([configId, status, sequence])
}

model AiSettings {
  id               String   @id @default("global")
  enabled          Boolean  @default(false)
  revision         Int      @default(1)
  dailyRequestLimit Int      @default(50)
  blockedFields    Json     @default("{}")
  updatedAt        DateTime @updatedAt
}

model AiModel {
  id            String   @id @default(uuid())
  name          String
  modelId       String
  baseUrl       String
  apiKeyCipher  String
  enabled       Boolean  @default(true)
  vision        Boolean  @default(false)
  tools         Boolean  @default(true)
  allowedUserIds Json    @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiPolicy {
  subjectId String   @id
  enabled   Boolean  @default(true)
  rules     Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model AiConversation {
  id                String   @id @default(uuid())
  actorId           String
  ownerId           String
  ownerIds          Json     @default("[]")
  modelId           String
  settingsRevision  Int
  authorizationHash String
  processingUntil   DateTime?
  title             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  messages          AiMessage[]
  proposals         AiProposal[]
  @@index([actorId, ownerId, updatedAt])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AiProposal {
  id             String   @id @default(uuid())
  conversationId String
  actorId        String
  ownerId        String
  resource       String
  operation      String
  payload        Json
  preview        Json
  status         String   @default("PENDING")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([actorId, status])
}

model AiAttachment {
  id        String   @id @default(uuid())
  actorId   String
  mediaType String
  bytes     Bytes
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([actorId, expiresAt])
}

model AiAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  ownerId   String?
  modelId   String?
  action    String
  resource  String?
  proposalId String?
  detail    Json     @default("{}")
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

enum UserRole {
  ROOT_ADMIN
  SUB_ADMIN
  FRONTEND_USER
  FRONTEND_SUB_USER
}

enum FrontendMenuPermission {
  DATA_MAIN
  DATA_STANDARD_SAMPLE
  DATA_COEFFICIENT
  LAB_REPORT_IMAGE_TEMPLATE
  LAB_REPORT_SMS_TEMPLATE
  ATTENDANCE_OVERVIEW
  ATTENDANCE_EMPLOYEES
  ATTENDANCE_SCHEDULES
  ATTENDANCE_RECORDS
  ATTENDANCE_LEAVE
  ATTENDANCE_COMPENSATION
  ATTENDANCE_PAYROLL
  FINANCE_EXPENSES
  FINANCE_INCOME
  FINANCE_UNSETTLED
  FINANCE_MONTHLY_SETTLEMENT
  PREPAID_RECHARGE
  PREPAID_CUSTOMERS
  PREPAID_CONSUMPTIONS
  PREPAID_SETTLEMENTS
  REPORTS
  MEDICINE_STOCK
  MEDICINE_INBOUND
  MEDICINE_OUTBOUND
  CUSTOMER_OVERVIEW
  BLACKLIST
}

enum FrontendPreferenceSection {
  LAB_REPORT_TEMPLATE
  LAB_REPORT_SMS_TEMPLATE
  LAB_REPORT_SAMPLE_UNITS
  LAB_ELEMENT_GROUPS
}

enum PaymentMethod {
  cash
  online
}

enum SamplePaymentStatus {
  PAID
  UNPAID
  MONTHLY
  PREPAID
  UNSELECTED
}

enum SampleRetestStatus {
  ACTIVE
  VOID
}

enum MonthlySettlementStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ReminderType {
  UNSETTLED_PAYMENT
  MONTHLY_PAYMENT
  FINANCE_DELETE_APPROVED
  FINANCE_DELETE_REJECTED
  LAB_SAMPLE_CHANGE_APPROVED
  LAB_SAMPLE_CHANGE_REJECTED
}

enum LabSampleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FinanceDeletionRequestType {
  EXPENSE
  PREPAID_RECHARGE
}

enum FinanceDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MedicineUnit {
  BOTTLE
  LITER
  MILLILITER
  GRAM
}

enum MedicineMovementType {
  INBOUND
  OUTBOUND
  CORRECTION_IN
  CORRECTION_OUT
}

enum AccessGuardFeature {
  FINANCE
  REPORTS
  BLACKLIST
  HISTORICAL_DATES
  MEDICINE_INVENTORY
  CUSTOMER_OVERVIEW
  COMPLETED_SAMPLE_DATA
  EMPLOYEE_ATTENDANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeLeaveUnit {
  HOUR
  HALF_DAY
  FULL_DAY
}

enum EmployeeLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeePayrollStatus {
  DRAFT
  CONFIRMED
}

enum EmployeeAuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CONFIRM
  REOPEN
  REVEAL
}

enum CalculationDraftKind {
  STANDARD_SAMPLE
  COEFFICIENT
}

enum SharedPrepaidLedgerKind {
  RECHARGE
  CONSUMPTION
  CONSUMPTION_REVERSAL
  RECHARGE_REVERSAL
}

enum SharedPrepaidConsumptionKind {
  CONSUMPTION
  REVERSAL
}

enum SharedPrepaidPayableStatus {
  PENDING
  HELD
  COMPLETED
  REVERSED
}

enum SharedPrepaidSettlementStatus {
  AWAITING_PAYMENT
  AWAITING_RECEIPT
  COMPLETED
  REJECTED
  CANCELLED
}

enum SharedPrepaidSettlementActionOperation {
  SUBMIT_PAYMENT
  CONFIRM_RECEIPT
  REJECT
  CANCEL
}

model User {
  id                          String    @id @default(uuid())
  account                     String    @unique
  username                    String
  displayRemark               String?
  role                        UserRole
  parentFrontendUserId        String?
  permissionVersion           Int       @default(1)
  requiresAccessGuardPassword Boolean   @default(true)
  lastLoginAt                 DateTime?
  passwordHash                String
  passwordCipher              String?
  accessGuardEnabled          Boolean   @default(false)
  accessGuardPassword         String?
  accessGuardTtlMinutes       Int       @default(5)
  accessGuardRecoveryPrompt   String?
  accessGuardRecoveryAnswer   String?
  disabled                    Boolean   @default(false)
  disabledReason              String?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  frontendSheets                      LabSheet[]                      @relation("FrontendSheets")
  financeEntries                      FinanceEntry[]                  @relation("FrontendFinance")
  monthlyCustomerRemarks              MonthlyCustomerRemark[]         @relation("FrontendMonthlyCustomerRemarks")
  customers                           Customer[]                      @relation("FrontendCustomers")
  blacklistUploads                    BlacklistRecord[]               @relation("BlacklistUploader")
  reminders                           Reminder[]                      @relation("FrontendReminders")
  createdReminders                    Reminder[]                      @relation("ReminderCreator")
  financeDeletionRequests             FinanceDeletionRequest[]        @relation("FrontendFinanceDeletionRequests")
  reviewedFinanceDeletionRequests     FinanceDeletionRequest[]        @relation("ReviewedFinanceDeletionRequests")
  inviteCodes                         InviteCode[]                    @relation("InviteCreator")
  usedInviteCodes                     InviteCode[]                    @relation("InviteUser")
  createdSubPerms                     SubAdminFrontendPermission[]    @relation("PermissionCreator")
  subAdminPerms                       SubAdminFrontendPermission[]    @relation("SubAdminPermissions")
  frontendPerms                       SubAdminFrontendPermission[]    @relation("FrontendPermissions")
  medicineItems                       MedicineInventoryItem[]         @relation("FrontendMedicineItems")
  medicineMovements                   MedicineInventoryMovement[]     @relation("FrontendMedicineMovements")
  medicineCommonNames                 MedicineCommonName[]            @relation("FrontendMedicineCommonNames")
  accessGuardGroups                   AccessGuardGroup[]              @relation("FrontendAccessGuardGroups")
  accessGuardGroupFeatures            AccessGuardGroupFeature[]       @relation("FrontendAccessGuardGroupFeatures")
  employees                           Employee[]
  employeeWeeklySchedules             EmployeeWeeklySchedule[]
  employeeDateOverrides               EmployeeDateOverride[]
  employeeMonthlySettings             EmployeeMonthlySetting[]
  employeeMonthlyScheduleDays         EmployeeMonthlyScheduleDay[]
  employeeScheduleSegments            EmployeeScheduleSegment[]
  employeeAttendanceRecords           EmployeeAttendanceRecord[]
  employeeAttendanceSegments          EmployeeAttendanceSegment[]
  employeeLeaveTypes                  EmployeeLeaveType[]
  employeeLeaveRequests               EmployeeLeaveRequest[]          @relation("FrontendEmployeeLeaveRequests")
  reviewedEmployeeLeaveRequests       EmployeeLeaveRequest[]          @relation("EmployeeLeaveReviewer")
  employeeCommissionTypes             EmployeeCommissionType[]
  employeeCommissionRecords           EmployeeCommissionRecord[]
  employeeBonuses                     EmployeeBonus[]
  employeePayrollRuns                 EmployeePayrollRun[]            @relation("FrontendEmployeePayrollRuns")
  confirmedEmployeePayrollRuns        EmployeePayrollRun[]            @relation("EmployeePayrollConfirmer")
  employeePayrollItems                EmployeePayrollItem[]
  employeePayrollAdjustments          EmployeePayrollAdjustment[]
  employeeAuditLogs                   EmployeeAuditLog[]              @relation("FrontendEmployeeAuditLogs")
  performedEmployeeAuditLogs          EmployeeAuditLog[]              @relation("EmployeeAuditActor")
  createdSharedPrepaidMembers         SharedPrepaidMember[]           @relation("SharedPrepaidMemberCreator")
  ownedSharedPrepaidRecharges         SharedPrepaidRecharge[]         @relation("SharedPrepaidRechargeOwner")
  actedSharedPrepaidRecharges         SharedPrepaidRecharge[]         @relation("SharedPrepaidRechargeActor")
  ownedSharedPrepaidLedgerEntries     SharedPrepaidLedgerEntry[]      @relation("SharedPrepaidLedgerEntryOwner")
  actedSharedPrepaidLedgerEntries     SharedPrepaidLedgerEntry[]      @relation("SharedPrepaidLedgerEntryActor")
  sharedPrepaidConsumptions           SharedPrepaidConsumption[]      @relation("SharedPrepaidConsumptionOwner")
  actedSharedPrepaidConsumptions      SharedPrepaidConsumption[]      @relation("SharedPrepaidConsumptionActor")
  sharedPrepaidAllocationSources      SharedPrepaidAllocation[]       @relation("SharedPrepaidAllocationSourceOwner")
  sourceSharedPrepaidPayables         SharedPrepaidPayable[]          @relation("SharedPrepaidPayableSourceOwner")
  consumerSharedPrepaidPayables       SharedPrepaidPayable[]          @relation("SharedPrepaidPayableConsumerOwner")
  sharedPrepaidSettlementsAsA         SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementAccountA")
  sharedPrepaidSettlementsAsB         SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementAccountB")
  paidSharedPrepaidSettlements        SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementPayer")
  receivedSharedPrepaidSettlements    SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementReceiver")
  createdSharedPrepaidSettlements     SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementCreator")
  submittedSharedPrepaidPayments      SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementPaymentSubmitter")
  confirmedSharedPrepaidReceipts      SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementReceiptConfirmer")
  rejectedSharedPrepaidSettlements    SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementRejector")
  cancelledSharedPrepaidSettlements   SharedPrepaidSettlement[]       @relation("SharedPrepaidSettlementCanceller")
  actedSharedPrepaidSettlementActions SharedPrepaidSettlementAction[] @relation("SharedPrepaidSettlementActionActor")
  ownedSharedPrepaidSettlementActions SharedPrepaidSettlementAction[] @relation("SharedPrepaidSettlementActionOwner")
  ownedFrontendBusinessPreferences    FrontendBusinessPreference[]    @relation("FrontendBusinessPreferenceOwner")
  updatedFrontendBusinessPreferences  FrontendBusinessPreference[]    @relation("FrontendBusinessPreferenceActor")
  labTotalMonitorSetting              LabTotalMonitorSetting?        @relation("LabTotalMonitorOwner")
  updatedLabTotalMonitorSettings      LabTotalMonitorSetting[]       @relation("LabTotalMonitorActor")
  parentFrontendUser                  User?                           @relation("FrontendSubAccounts", fields: [parentFrontendUserId], references: [id], onDelete: Restrict)
  frontendSubAccounts                 User[]                          @relation("FrontendSubAccounts")
  frontendSubAccountPermissions       FrontendSubAccountPermission[]
  calculationDrafts                   FrontendCalculationDraft[]
  frontendLabSampleChangeRequests     LabSampleChangeRequest[]        @relation("FrontendLabSampleChangeRequests")
  requestedLabSampleChangeRequests    LabSampleChangeRequest[]        @relation("RequestedLabSampleChangeRequests")
  reviewedLabSampleChangeRequests     LabSampleChangeRequest[]        @relation("ReviewedLabSampleChangeRequests")

  @@index([role])
  @@index([parentFrontendUserId])
  @@index([deletedAt])
}

model LabTotalMonitorSetting {
  frontendUserId String   @id
  rules          Json
  version        Int      @default(1)
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("LabTotalMonitorOwner", fields: [frontendUserId], references: [id], onDelete: Restrict)
  updatedBy    User @relation("LabTotalMonitorActor", fields: [updatedById], references: [id], onDelete: Restrict)
}

model FrontendBusinessPreference {
  id             String                    @id @default(uuid())
  frontendUserId String
  section        FrontendPreferenceSection
  value          Json
  version        Int                       @default(1)
  updatedById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  frontendUser User @relation("FrontendBusinessPreferenceOwner", fields: [frontendUserId], references: [id], onDelete: Restrict)
  updatedBy    User @relation("FrontendBusinessPreferenceActor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([frontendUserId, section])
  @@index([frontendUserId])
  @@index([updatedById])
}

model FrontendSubAccountPermission {
  id           String                 @id @default(uuid())
  subAccountId String
  permission   FrontendMenuPermission
  createdAt    DateTime               @default(now())

  subAccount User @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([subAccountId, permission])
  @@index([subAccountId])
}

model FrontendCalculationDraft {
  id             String               @id @default(uuid())
  frontendUserId String
  kind           CalculationDraftKind
  payload        Json
  revision       Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  frontendUser   User                 @relation(fields: [frontendUserId], references: [id], onDelete: Cascade)

  @@unique([frontendUserId, kind])
  @@index([frontendUserId])
}

model AccessGuardGroup {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  enabled        Boolean  @default(true)
  ttlMinutes     Int      @default(5)
  grantVersion   Int      @default(1)
  password       String
  recoveryPrompt String
  recoveryAnswer String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User                      @relation("FrontendAccessGuardGroups", fields: [frontendUserId], references: [id], onDelete: Cascade)
  features     AccessGuardGroupFeature[]

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model AccessGuardGroupFeature {
  id             String             @id @default(uuid())
  groupId        String
  frontendUserId String
  feature        AccessGuardFeature
  createdAt      DateTime           @default(now())

  group        AccessGuardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  frontendUser User             @relation("FrontendAccessGuardGroupFeatures", fields: [frontendUserId], references: [id], onDelete: Cascade)

  @@unique([frontendUserId, feature])
  @@unique([groupId, feature])
  @@index([groupId])
}

model Customer {
  id             String   @id @default(uuid())
  frontendUserId String
  name           String
  phone          String?
  wechat         String?
  wechatNickname String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser User @relation("FrontendCustomers", fields: [frontendUserId], references: [id])

  @@unique([frontendUserId, name])
  @@index([frontendUserId])
}

model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  note        String?
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  usedById    String?

  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id])
}

model SubAdminFrontendPermission {
  id             String   @id @default(uuid())
  subAdminId     String
  frontendUserId String
  createdById    String
  createdAt      DateTime @default(now())

  subAdmin     User @relation("SubAdminPermissions", fields: [subAdminId], references: [id])
  frontendUser User @relation("FrontendPermissions", fields: [frontendUserId], references: [id])
  createdBy    User @relation("PermissionCreator", fields: [createdById], references: [id])

  @@unique([subAdminId, frontendUserId])
  @@index([frontendUserId])
}

model LabSheet {
  id             String   @id @default(uuid())
  frontendUserId String
  date           String
  readonly       Boolean  @default(false)
  parameters     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  frontendUser              User                       @relation("FrontendSheets", fields: [frontendUserId], references: [id])
  sampleBlocks              SampleBlock[]
  changeLogs                CellChangeLog[]
  abnormalRecords           AbnormalRecord[]
  sharedPrepaidConsumptions SharedPrepaidConsumption[] @relation("SharedPrepaidConsumptionSheet")
  changeRequests            LabSampleChangeRequest[]

  @@unique([frontendUserId, date])
  @@index([date])
}

model SampleBlock {
  id                String   @id @default(uuid())
  sheetId           String
  index             Int
  readonly          Boolean  @default(false)
  inputs            Json
  results           Json
  parameterSnapshot Json
  nextRetestSequence Int            @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sheet                     LabSheet                   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  changeLogs                CellChangeLog[]
  abnormalRecords           AbnormalRecord[]
  sharedPrepaidConsumptions SharedPrepaidConsumption[] @relation("SharedPrepaidConsumptionBlock")
  retests                   SampleRetest[]
  changeRequests            LabSampleChangeRequest[]

  @@unique([sheetId, index])
  @@index([sheetId])
}

model SampleRetest {
  id                String             @id @default(uuid())
  sampleBlockId     String
  sequence          Int
  inputs            Json
  results           Json
  parameterSnapshot Json
  everFilled        Boolean            @default(false)
  status            SampleRetestStatus @default(ACTIVE)
  voidReason        String?
  createdById       String
  updatedById       String
  voidedById        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  voidedAt          DateTime?

  sampleBlock SampleBlock @relation(fields: [sampleBlockId], references: [id], onDelete: Cascade)

  @@unique([sampleBlockId, sequence])
  @@index([sampleBlockId, status, sequence])
}

model SampleRetestWriteRequest {
  idempotencyKey     String   @id
  requestFingerprint String
  operation          String
  sheetId            String
  sampleBlockId      String?
  sampleRetestId     String?
  responseSnapshot   Json
  createdAt          DateTime @default(now())

  @@index([sheetId, sampleBlockId])
  @@index([sampleRetestId])
  @@index([createdAt])
}

model LabSampleSaveRequest {
  idempotencyKey     String   @id
  requestFingerprint String
  sheetId            String
  sampleBlockId      String
  responseSnapshot   Json
  createdAt          DateTime @default(now())

  @@index([sheetId, sampleBlockId])
  @@index([createdAt])
}

model CellChangeLog {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  field          String
  oldValue       Json?
  newValue       Json?
  changedById    String
  changeRequestId String?
  changedAt      DateTime @default(now())

  sheet         LabSheet               @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block         SampleBlock            @relation(fields: [blockId], references: [id], onDelete: Cascade)
  changeRequest LabSampleChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([frontendUserId, changedAt])
  @@index([blockId, field])
}

model LabSampleChangeRequest {
  id                 String                       @id @default(uuid())
  frontendUserId     String
  requestedById      String
  sheetId            String
  blockId            String
  date               String
  blockIndex         Int
  baseBlockUpdatedAt DateTime
  sourceSnapshot     Json
  requestedChanges   Json
  previewResults     Json
  reason             String
  status             LabSampleChangeRequestStatus @default(PENDING)
  reviewRemark       String?
  reviewedById       String?
  reviewedAt         DateTime?
  withdrawnAt        DateTime?
  settlementEffects  Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  frontendUser User         @relation("FrontendLabSampleChangeRequests", fields: [frontendUserId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("RequestedLabSampleChangeRequests", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("ReviewedLabSampleChangeRequests", fields: [reviewedById], references: [id], onDelete: Restrict)
  sheet        LabSheet     @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  block        SampleBlock  @relation(fields: [blockId], references: [id], onDelete: Restrict)
  changeLogs   CellChangeLog[]

  @@index([frontendUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([sheetId, blockId])
  @@index([reviewedById])
}

model AbnormalRecord {
  id             String   @id @default(uuid())
  sheetId        String
  blockId        String
  frontendUserId String
  date           String
  field          String
  changeCount    Int
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sheet LabSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  block SampleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

