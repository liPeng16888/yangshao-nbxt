model Employee {
  id                     String         @id @default(uuid())
  frontendUserId         String
  employeeNumber         String
  name                   String
  status                 EmployeeStatus @default(ACTIVE)
  phone                  String?
  idCardCipher           String?
  bankCardCipher         String?
  addressCipher          String?
  emergencyContactCipher String?
  photoPath              String?
  hireDate               String
  terminationDate        String?
  baseSalary             Decimal        @default(0) @db.Decimal(12, 2)
  attendanceBonus        Decimal        @default(0) @db.Decimal(12, 2)
  overtimeHourlyRate     Decimal        @default(0) @db.Decimal(12, 2)
  restQuotaDays          Decimal        @default(0) @db.Decimal(6, 2)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  frontendUser       User                        @relation(fields: [frontendUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  weeklySchedules    EmployeeWeeklySchedule[]
  dateOverrides      EmployeeDateOverride[]
  monthlySettings    EmployeeMonthlySetting[]
  attendanceRecords  EmployeeAttendanceRecord[]
  leaveRequests      EmployeeLeaveRequest[]
  commissionRecords  EmployeeCommissionRecord[]
  bonuses            EmployeeBonus[]
  payrollItems       EmployeePayrollItem[]
  payrollAdjustments EmployeePayrollAdjustment[]

  @@unique([frontendUserId, employeeNumber])
  @@unique([id, frontendUserId])
  @@index([frontendUserId, status])
  @@index([frontendUserId, name])
}

