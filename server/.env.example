DATABASE_URL=postgresql://yangshao:yangshao_password@127.0.0.1:5432/yangshao_nbxt?schema=public
JWT_SECRET=change-this-before-deploy
PASSWORD_CIPHER_SECRET=32-byte-minimum-secret-change-me
# 员工身份证、银行卡等字段的独立密钥；至少 32 个 UTF-8 字节，投产后必须固定并妥善备份。
EMPLOYEE_DATA_CIPHER_SECRET=separate-32-byte-minimum-secret-change-me
# 私有员工照片目录。生产环境请使用不在 UPLOAD_DIR/公开 Web 根目录内的绝对路径。
PRIVATE_EMPLOYEE_PHOTO_DIR=private-uploads/employee-photos
ROOT_ADMIN_ACCOUNT=admin
ROOT_ADMIN_PASSWORD=admin123456
ROOT_ADMIN_NAME=主账号
UPLOAD_DIR=uploads
SERVER_PORT=3000
# AI API 密钥的独立加密密钥，至少 32 个 UTF-8 字节；投产后固定并备份。
# AI 默认关闭，需要主管理员在「AI API 配置」中添加模型并授权。
AI_API_KEY_SECRET=separate-32-byte-minimum-ai-secret-change-me
